{
  "name": "fruit-2048",
  "version": "1.0.0",
  "description": "珍馐水果合成 2048",
  "main": "main.js",
  "author": "local",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "local.fruit2048.app",
    "productName": "珍馐水果合成",
    "artifactName": "Fruit2048-Setup-${version}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "../assets"
    },
    "files": [
      "main.js",
      "web/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ],
      "icon": "../assets/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "珍馐水果合成",
      "deleteAppDataOnUninstall": false
    }
  }
}
